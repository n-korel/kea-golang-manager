---
alwaysApply: true

version: 1

project:
  name: kea-golang-manager
  stack:
    dhcp: "Kea DHCP"
    backend: "Go"
    deployment: "Docker Compose (bridge)"
    ha_mode: "none"
    lease_backend: "memfile"

topology:
  nodes:
    - name: kea-dhcp4
      dhcp4_port: 67
      control_agent_port: 8000
  manager_port: 8080

# =========================================================
# GLOBAL RULES
# =========================================================

global_rules:
  - id: no-dhcp-reimplementation
    description: >
      Do not implement DHCP protocol logic in Go.
      Kea is the sole DHCP engine.

  - id: no-database
    description: >
      Do not introduce MySQL, PostgreSQL, or any external lease database.
      Use memfile only.

  - id: no-ha
    description: >
      This project manages a single Kea node. Do not implement HA,
      Active-Standby, failover logic, election algorithms, heartbeats,
      or any multi-node coordination. Ever.

  - id: no-snmp-lldp
    description: >
      Do not add SNMP or LLDP integrations. Kea's own statistic-get
      provides all the monitoring data this project needs.

  - id: no-host-network
    description: >
      Do not use network_mode: host in Docker. Use bridge networking
      with explicit port mappings. host mode breaks on Windows / Docker Desktop.

  - id: no-direct-lease-manipulation
    description: >
      Do not read, write, or parse Kea lease files directly.
      All operations go through the Control Agent HTTP API.

# =========================================================
# CONFIG AUTHORITY MODEL
# =========================================================

config_authority:
  - Backend is the canonical configuration source.
  - All config changes go through Kea Control Agent (config-set).
  - Always call config-write after config-set to persist to disk.
  - config-write must be called on the same node as config-set.
  - Concurrent config writes are forbidden (single-writer policy).
  - Never edit Kea config files directly from Go code.

# =========================================================
# KEA RULES
# =========================================================

kea_rules:
  ha:
    required: false
    forbidden:
      - high-availability hook library
      - passive-backup mode
      - load-balancing mode
      - heartbeat configuration
      - peer configuration

  lease_backend:
    type: "memfile"
    persistence_required: false
    notes:
      - Lease loss after crash is acceptable
      - Do not simulate or add durability guarantees

  reload_policy:
    - Use config-set to apply changes at runtime
    - Always follow config-set with config-write
    - Use config-reload to apply after config-write
    - Reload must be observable (logged, returned in API response)
    - Never edit kea-dhcp4.conf directly from Go code

# =========================================================
# DOCKER RULES
# =========================================================

docker_rules:
  networking:
    required_mode: "bridge"
    forbidden:
      - network_mode: host
      - cap_add: NET_RAW
      - cap_add: NET_ADMIN
    port_mappings:
      - "8000:8000"   # Kea Control Agent → host

  services:
    - name: kea-dhcp4
      image: "jonasal/kea-dhcp4:2"
      config: "config/kea-dhcp4.conf"
    - name: kea-control-agent
      image: "jonasal/kea-ctrl-agent:2"
      config: "config/kea-ctrl-agent.conf"

  volumes:
    - kea-socket   # shared unix socket between kea-dhcp4 and kea-control-agent
    - kea-leases   # memfile lease storage

  restart_policy: "unless-stopped"

# =========================================================
# BACKEND RULES
# =========================================================

backend_rules:
  package_structure:
    - cmd/app/           # main: CLI flag parsing, command dispatch, HTTP server setup
    - internal/kea/      # Kea Control Agent HTTP client + models
    - internal/api/      # HTTP handlers (chi router)
    - internal/service/  # DHCPService: validation + business logic
    - pkg/config/        # App configuration (URL, timeout)

  forbidden_packages:
    - internal/ha/       # Must not exist
    - internal/snmp/     # Must not exist
    - internal/lldp/     # Must not exist

  responsibilities:
    - Manage DHCP configuration via Kea Control Agent API
    - Validate subnets and pools before applying
    - Expose REST API for subnet CRUD and reload
    - Report Kea reachability and lease stats

  forbidden:
    - Any HA or failover logic
    - SNMP polling
    - LLDP collection
    - Lease file manipulation
    - DHCP packet crafting
    - Global mutable state
    - fmt.Println in production paths (use log/slog)

  api_endpoints_required:
    - path: "GET /health"
      behavior: >
        Calls config-get (or a lightweight ping) on Control Agent.
        Returns {"status":"ok","kea":{"reachable":true}} on success.
        Returns HTTP 503 if Kea is unreachable.

    - path: "GET /config"
      behavior: "Returns full Kea config JSON from config-get"

    - path: "POST /kea/reload"
      behavior: "Calls config-write then config-reload. Alias: POST /reload"

    - path: "GET /stats"
      behavior: >
        Calls statistic-get on Kea dhcp4 service.
        Returns flat JSON of lease counters (total, assigned, declined).

    - path: "GET /subnets"
      behavior: "Lists subnet4 from current Kea config"

    - path: "POST /subnets"
      behavior: >
        Validates subnet CIDR and pool ranges, then calls config-set + config-write.
        Supports optional reservations array.

    - path: "DELETE /subnets/{id}"
      behavior: "Removes subnet by ID via config-set + config-write"

  design_constraints:
    - Use context.Context everywhere; pass it through all layers
    - No global mutable state
    - Structured logging only (log/slog); level from LOG_LEVEL env var
    - Graceful shutdown on SIGTERM / SIGINT (http.Server.Shutdown)
    - Request timeout configurable via -timeout flag
    - config-write must always follow config-set (reload_policy)

# =========================================================
# TESTING RULES
# =========================================================

testing_rules:
  approach: "unit tests with mocks — no live Kea required"
  required:
    - DHCPService.ValidateSubnet: valid CIDR, invalid CIDR, IPv6 rejection
    - DHCPService.ValidatePool: valid range, reversed range, out-of-subnet range
    - DHCPService.AddSubnet: calls client with correct Subnet4 struct
    - API handler /health: returns 200 when client reachable, 503 when not
    - API handler POST /subnets: returns 400 on missing subnet field
    - kea.Client response parsing: single-object response, array response, error result
  expectations:
    - go test ./... must pass with no external dependencies
    - No Docker, no network, no file system access in unit tests

# =========================================================
# OBSERVABILITY RULES
# =========================================================

observability_rules:
  logging:
    - Use log/slog exclusively — never fmt.Println or log.Printf in handlers
    - Log level from LOG_LEVEL env var (debug / info / warn / error); default info
    - Log every config mutation: add subnet, delete subnet, reload
    - Log all errors with context (operation name, error message)
    - Do not log sensitive data (credentials, full request bodies)

# =========================================================
# SECURITY RULES
# =========================================================

security_rules:
  - Control Agent port 8000 must only be exposed to localhost or internal network
  - No hardcoded credentials anywhere in source code
  - Internal Kea unix socket must not be mounted outside its containers

# =========================================================
# NON-GOALS
# =========================================================

non_goals:
  - active_standby_ha
  - active_active_ha
  - failover_or_election_logic
  - snmp_integration
  - lldp_integration
  - lease_database_backend
  - host_network_mode
  - custom_dhcp_implementation
  - direct_lease_file_access
---
